# Copy this file to .env and fill in your key. The key stays on the server only.
# The browser never sees it: it calls POST /api/extract on this Node server.
OPENAI_API_KEY=

# Optional. Defaults work with any OpenAI-compatible /chat/completions API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional. Defaults to 8080.
PORT=8080
